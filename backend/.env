# Copy this to .env and fill in your values

# For local dev — SQLite (easiest, no setup needed)
DATABASE_URL=sqlite:///./signature_app.db

# For production — use Supabase or Neon PostgreSQL URL like:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Change this to a long random string in production!
SECRET_KEY=my-super-secret-key-change-this

# Where uploaded PDFs are stored
UPLOAD_DIR=uploads
